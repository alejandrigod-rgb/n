{
  "name": "n",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto de video con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render Celulas out/celulas.mp4",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "build:nutricion": "remotion render AlimentacionEquilibrio out/alimentacion-equilibrio.mp4",
    "audio:nutricion": "NODE_USE_ENV_PROXY=1 node scripts/generar-audio-nutricion.mjs",
    "transcribir": "hyperframes transcribe --engine whisper --model small --language es",
    "audio:programacion": "NODE_USE_ENV_PROXY=1 node scripts/generar-audio.mjs programacion",
    "build:programacion": "remotion render ComoFuncionaLaProgramacion out/programacion-crudo.mp4 && scripts/normalizar-audio.sh out/programacion-crudo.mp4 out/como-funciona-la-programacion.mp4",
    "audio:pirateria": "NODE_USE_ENV_PROXY=1 node scripts/generar-audio.mjs pirateria && scripts/igualar-sfx.sh public/pirateria",
    "build:pirateria": "remotion render Pirateria out/pirateria-crudo.mp4 && scripts/normalizar-audio.sh out/pirateria-crudo.mp4 out/que-es-la-pirateria.mp4"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/captions": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/install-whisper-cpp": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "hyperframes": "0.9.19",
    "typescript": "5.9.3"
  }
}
